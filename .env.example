###############################################################################
# FFS-LandingPage 環境変数
#
# ../ffs-dcs-server/.env で設定した DCSSB_API_KEY と同値を入れること。
# 揃っていないと RestAPI が 401 を返す。
###############################################################################

# DCSServerBot RestAPI plugin の api_key (32 文字以上の乱数推奨)
DCSSB_API_KEY=

# 通常いじらない。別ホスト/別ポートで WebService を動かす場合のみ変更。
# DCSSB_WEBSERVICE_URL=http://dcs-server-1:9876
# DCSSB_API_PREFIX=/stats

# DCSSB postgres から FPS / CPU / メモリを直接 SELECT する読み取り専用 DSN。
# 姉妹 repo 側で `ffs_landing_ro` ROLE を作り `GRANT SELECT ON serverstats` 済み。
# 形式: postgresql://ffs_landing_ro:<pass>@ffs-postgres:5432/dcsserverbot
DCSSB_DB_URL=

# Google Analytics 4 の測定 ID (任意)。GA 管理画面 → データストリーム → ウェブ
# で確認できる G-XXXXXXXXXX。空のままなら計測タグを出さない (ローカル開発向け)。
# 開示は /privacy ページで行っている。GA 側で広告系の機能を有効にしたら記載も直すこと。
GA_MEASUREMENT_ID=

###############################################################################
# Caddy (必須) — 未設定のまま `docker compose up` すると compose が起動前に
# エラーで止まる。
#
# 内部ネットワークの構成 (ホスト側のポート番号、LAN 内の転送先) は公開リポジトリに
# 書かず、ここ (.env) で与える。
###############################################################################
# ルータが WAN の 80/tcp・443/tcp を転送してくる、このホスト側のポート番号 (数字のみ)。
# caddy コンテナの :80 / :443 に publish される。
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=

# LAN 内の別ホストにある Webhook 受け口の転送先。書式は host:port (スキーム無し)。
# 例: <HOST_LAN_IP>:<PORT>
#   HERMES_LINE_WEBHOOK_UPSTREAM    freedomflight.jp/line/webhook (Hermes の公式LINE 受け口)
#   HERMES_GCAL_WEBHOOK_UPSTREAM    freedomflight.jp/google/calendar/watch (Hermes の Calendar push 受け口)
#   IYAKUSAI_LINE_WEBHOOK_UPSTREAM  line.iyakusai.com/webhook (医薬祭 公式LINE の取り込み口)
# Caddy 自体は空でも起動してしまい、その経路が 503 を返し続ける (LINE は失敗が
# 続くと Webhook を無効化する)。compose の `:?` 指定で起動前に止めているので、
# 値を空にしないこと (compose 側の `:?` も外さないこと)。
HERMES_LINE_WEBHOOK_UPSTREAM=
HERMES_GCAL_WEBHOOK_UPSTREAM=
IYAKUSAI_LINE_WEBHOOK_UPSTREAM=

###############################################################################
# ffs-website (任意) — 空なら既定値
###############################################################################
# 実行ユーザーの uid/gid (既定 10001)。./data (Fitbit トークン保存先) の所有者と
# 揃えること。ホストで data/ を手で編集したい場合はホストユーザーの uid/gid に
# してもよい。変えたら `docker compose up -d --build` でイメージを作り直す。
APP_UID=
APP_GID=

# /proxy/tracks (リプレイ DL) の同時ダウンロード数の上限 (1 以上の整数)。
#   TRACK_DOWNLOAD_CONCURRENCY  全体の上限 (既定 4)。超えたら 503
#   TRACK_DOWNLOAD_PER_CLIENT   接続元 1 つあたりの上限 (既定 2)。超えたら 429
# どちらも Retry-After 付きで、待たせずに断る。
TRACK_DOWNLOAD_CONCURRENCY=
TRACK_DOWNLOAD_PER_CLIENT=

###############################################################################
# Pilot Health パネル (任意) — Google Health API 経由で Charge 6 の心拍/睡眠を表示
#
# 変数名は FITBIT_* だが、中身は Google Cloud の OAuth クライアントの値
# (app/fitbit.py / fitbit_auth.py が読む)。
#
# 設定手順:
#   1. Google Cloud Console でプロジェクトを作成
#   2. 「Google Health API」(health.googleapis.com) を有効化
#   3. 「認証情報」→「OAuth 2.0 クライアント ID」(デスクトップ アプリ) を作成
#      - 承認済みのリダイレクト URI: http://localhost:8080/callback
#      - 要求するスコープ (fitbit_auth.py):
#          googlehealth.health_metrics_and_measurements.readonly
#          googlehealth.sleep.readonly
#   4. 下記に Client ID と Client Secret を設定
#   5. python3 fitbit_auth.py を実行して FITBIT_REFRESH_TOKEN を取得・設定
#      (Client ID / Secret は環境変数 FITBIT_CLIENT_ID / FITBIT_CLIENT_SECRET か
#       対話入力で渡す。data/fitbit_tokens.json に保存する方法も出力される)
#   6. docker compose up -d --build で反映
###############################################################################
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REFRESH_TOKEN=
