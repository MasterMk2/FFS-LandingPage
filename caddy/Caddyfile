###############################################################################
# Caddy reverse proxy / static host
#
# ネットワーク経路:
#   [WAN] :80/:443 → [router NAPT] → 192.168.3.170:30080 / :30443
#     → [host] → docker publish → [ffs-caddy] :80 / :443 (container internal)
# Caddy 自身はコンテナ内で標準の 80/443 を listen する。
#
# TLS:
#   各サイト DNS が host の公開 IP に向いて、かつルータ NAPT が上記経路で
#   通るようになったら、サイトブロック先頭の `http://` を外すだけで
#   Let's Encrypt が自動発行する。
#
# 振り分け:
#   iyakusai.com / www.iyakusai.com / 2025.iyakusai.com
#       → /srv/iyakusai/ の静的ファイル
#   freedomflight.jp / www.freedomflight.jp
#       → ffs-website:8000 (FastAPI)
#   catch-all (未登録ホスト / IP 直打ち on :80)
#       → 404
###############################################################################

{
	admin off
	email xxxx@gmail.com
	log {
		output stdout
		format console
	}
}

(iyakusai_common) {
	root * /srv/iyakusai
	encode zstd gzip

	handle {
		file_server
	}
	log
}

iyakusai.com, www.iyakusai.com, 2025.iyakusai.com {
	import iyakusai_common
}

# www.freedomflight.jp は DNS 未設定のため TLS 化対象外。
# A レコード追加後に `freedomflight.jp, www.freedomflight.jp {` に戻す。
freedomflight.jp {
	encode zstd gzip
	reverse_proxy ffs-website:8000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
	log
}

# Sneaker (DCS Live Map) — ffs-sneaklardooon container の 7788 を HTTPS 終端。
# DNS: sneaker.freedomflight.jp A 111.237.107.64
sneaker.freedomflight.jp {
	encode zstd gzip
	reverse_proxy ffs-sneaklardooon:7788 {
		header_up X-Real-IP {remote_host}
	}
	log
}

# Lardoon (Tacview Replay archive) — ffs-sneaklardooon container の 3883 を HTTPS 終端。
# DNS: lardoon.freedomflight.jp A 111.237.107.64
lardoon.freedomflight.jp {
	encode zstd gzip
	reverse_proxy ffs-sneaklardooon:3883 {
		header_up X-Real-IP {remote_host}
	}
	log
}

:80 {
	respond "Not Found" 404
}
