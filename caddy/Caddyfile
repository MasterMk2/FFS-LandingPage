# MyGravityMap (姉妹 repo、Google マップタイムライン可視化) — 完全静的、gravitymap/
# を scripts/deploy-gravitymap.sh がビルド・同期。ffs-website / DCSSB とは無関係。
#
# crypto.subtle (Web Crypto API、ファイルハッシュ判定に使用) が secure context
# 必須のため、http:// では機能しない。DNS 設定済み (2026-08-21) につき TLS 化。
# DCS Web GCA をサブドメインで出したくなった場合はここを有効化する
# (A レコード gca.freedomflight.jp -> 111.237.107.64 を先に追加すること。
#  /gca/ 側と併存しても問題ない)。
# gca.freedomflight.jp {
# 	import security_headers
# 	encode zstd gzip
# 	reverse_proxy ffs-dcs-web-gca:8080 {
# 		header_up X-Real-IP {remote_host}
# 	}
# 	log
# }

gravitymap.freedomflight.jp {
	import security_headers
	root * /srv/gravitymap
	encode zstd gzip
	handle {
		file_server
	}
	log
}

:80 {
	respond "Not Found" 404
}

###############################################################################
# 公式LINE(@553herww)の Webhook 受け口
#   LINE → :443 → [router NAPT] → ffs-caddy → IYAKUSAI_LINE_WEBHOOK_UPSTREAM
#   受け口の実体は LAN 内の別ホストの取り込みサービス。
#   転送先の host:port は .env の IYAKUSAI_LINE_WEBHOOK_UPSTREAM で与える。
#   ★ 独立したサブドメインにしてあるのは、iyakusai.com が XREA へ移っても
#      この経路が生き残るようにするため(道連れになると受信が無音で止まる)
###############################################################################
line.iyakusai.com {
	import security_headers
	# 外に出すのは /webhook だけ。受け口の他のパスは認証付きでも
	# インターネットからは触らせない。
	handle /webhook {
		reverse_proxy {$IYAKUSAI_LINE_WEBHOOK_UPSTREAM}
	}
	handle {
		respond 404
	}
	log
}

# このサーバーだけのサイトブロック (git 管理外、freedomflight.jp の中の経路と同じ FFS_CADDY_LOCAL_DIR)。
# 公開リポジトリに書けない関係先のドメインなどはここに置く。ファイルが無くても起動する。
import /etc/caddy/local/sites/*.caddy
